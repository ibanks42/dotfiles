// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
//
// tmux-style "one window at a time" layout:
// - alt-1   editor (hides agent + terminal panels)
// - alt-2   agent (hides terminal panel)
// - alt-3-9 terminal tab N (hides agent panel, keeps terminal panel open;
//           pressing the key for the already-active tab is a no-op)
// - alt-n   new terminal
//
// Hidden helper bindings (sent via workspace::SendKeystrokes):
// - ctrl-alt-shift-e focus the center pane (editor)
// - ctrl-alt-shift-a agent::ToggleFocus
// - ctrl-alt-shift-t terminal_panel::ToggleFocus (opens + focuses the panel)
// - ctrl-alt-shift-b hide the bottom dock (only when it is open)
// - ctrl-alt-shift-r hide the right dock (only when it is open)
[
  {
    "context": "Workspace",
    "bindings": {
      "alt-1": ["workspace::SendKeystrokes", "ctrl-alt-shift-e ctrl-alt-shift-b ctrl-alt-shift-r"],
      "alt-2": ["workspace::SendKeystrokes", "ctrl-alt-shift-a ctrl-alt-shift-b"],
      "alt-3": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-3 ctrl-alt-shift-r"],
      "alt-4": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-4 ctrl-alt-shift-r"],
      "alt-5": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-5 ctrl-alt-shift-r"],
      "alt-6": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-6 ctrl-alt-shift-r"],
      "alt-7": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-7 ctrl-alt-shift-r"],
      "alt-8": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-8 ctrl-alt-shift-r"],
      "alt-9": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-9 ctrl-alt-shift-r"],
      "alt-n": ["action::Sequence", ["workspace::NewTerminal", "terminal_panel::ToggleFocus"]],
      "ctrl-alt-shift-e": "workspace::FocusCenterPane",
      "ctrl-alt-shift-a": "agent::ToggleFocus",
      "ctrl-alt-shift-t": "terminal_panel::ToggleFocus",
    },
  },
  {
    "context": "Workspace && bottom_dock",
    "bindings": {
      "ctrl-alt-shift-b": "workspace::ToggleBottomDock",
    },
  },
  {
    "context": "Workspace && right_dock",
    "bindings": {
      "ctrl-alt-shift-r": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "Pane && !Terminal",
    "bindings": {
      "alt-1": ["workspace::SendKeystrokes", "ctrl-alt-shift-e ctrl-alt-shift-b ctrl-alt-shift-r"],
      "alt-2": ["workspace::SendKeystrokes", "ctrl-alt-shift-a ctrl-alt-shift-b"],
      "alt-3": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-3 ctrl-alt-shift-r"],
      "alt-4": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-4 ctrl-alt-shift-r"],
      "alt-5": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-5 ctrl-alt-shift-r"],
      "alt-6": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-6 ctrl-alt-shift-r"],
      "alt-7": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-7 ctrl-alt-shift-r"],
      "alt-8": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-8 ctrl-alt-shift-r"],
      "alt-9": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-9 ctrl-alt-shift-r"],
      "alt-n": ["action::Sequence", ["workspace::NewTerminal", "terminal_panel::ToggleFocus"]],
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-1": ["workspace::SendKeystrokes", "ctrl-alt-shift-e ctrl-alt-shift-b ctrl-alt-shift-r"],
      "alt-2": ["workspace::SendKeystrokes", "ctrl-alt-shift-a ctrl-alt-shift-b"],
      "alt-3": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-3 ctrl-alt-shift-r"],
      "alt-4": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-4 ctrl-alt-shift-r"],
      "alt-5": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-5 ctrl-alt-shift-r"],
      "alt-6": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-6 ctrl-alt-shift-r"],
      "alt-7": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-7 ctrl-alt-shift-r"],
      "alt-8": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-8 ctrl-alt-shift-r"],
      "alt-9": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-9 ctrl-alt-shift-r"],
      "alt-n": ["action::Sequence", ["workspace::NewTerminal", "terminal_panel::ToggleFocus"]],
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "alt-1": ["workspace::SendKeystrokes", "ctrl-alt-shift-e ctrl-alt-shift-b ctrl-alt-shift-r"],
      "alt-2": ["workspace::SendKeystrokes", "ctrl-alt-shift-a ctrl-alt-shift-b"],
      "alt-3": ["pane::ActivateItem", 0],
      "alt-4": ["pane::ActivateItem", 1],
      "alt-5": ["pane::ActivateItem", 2],
      "alt-6": ["pane::ActivateItem", 3],
      "alt-7": ["pane::ActivateItem", 4],
      "alt-8": ["pane::ActivateItem", 5],
      "alt-9": ["pane::ActivateItem", 6],
      "alt-n": "workspace::NewTerminal",
      "ctrl-alt-shift-3": ["pane::ActivateItem", 0],
      "ctrl-alt-shift-4": ["pane::ActivateItem", 1],
      "ctrl-alt-shift-5": ["pane::ActivateItem", 2],
      "ctrl-alt-shift-6": ["pane::ActivateItem", 3],
      "ctrl-alt-shift-7": ["pane::ActivateItem", 4],
      "ctrl-alt-shift-8": ["pane::ActivateItem", 5],
      "ctrl-alt-shift-9": ["pane::ActivateItem", 6],
    },
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "alt-1": ["workspace::SendKeystrokes", "ctrl-alt-shift-e ctrl-alt-shift-b ctrl-alt-shift-r"],
      "alt-2": "agent::Toggle",
      "alt-3": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-3 ctrl-alt-shift-r"],
      "alt-4": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-4 ctrl-alt-shift-r"],
      "alt-5": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-5 ctrl-alt-shift-r"],
      "alt-6": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-6 ctrl-alt-shift-r"],
      "alt-7": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-7 ctrl-alt-shift-r"],
      "alt-8": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-8 ctrl-alt-shift-r"],
      "alt-9": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-9 ctrl-alt-shift-r"],
      "alt-n": ["action::Sequence", ["workspace::NewTerminal", "terminal_panel::ToggleFocus"]],
    },
  },
  {
    "context": "AgentPanel > Terminal",
    "bindings": {
      "alt-2": "agent::Toggle",
      "alt-3": ["pane::ActivateItem", 0],
      "alt-4": ["pane::ActivateItem", 1],
      "alt-5": ["pane::ActivateItem", 2],
      "alt-6": ["pane::ActivateItem", 3],
      "alt-7": ["pane::ActivateItem", 4],
      "alt-8": ["pane::ActivateItem", 5],
      "alt-9": ["pane::ActivateItem", 6],
      "alt-n": "workspace::NewTerminal",
    },
  },
  {
    "context": "AcpThread",
    "bindings": {
      "alt-2": "agent::Toggle",
    },
  },
  {
    "context": "AcpThread > Editor",
    "bindings": {
      "alt-2": "agent::Toggle",
    },
  },
  {
    "context": "AgentPanel > Editor",
    "bindings": {
      "alt-2": "agent::Toggle",
    },
  },
  {
    "context": "AgentTerminalThread",
    "bindings": {
      "alt-2": "agent::Toggle",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "alt-1": ["workspace::SendKeystrokes", "ctrl-alt-shift-e ctrl-alt-shift-b ctrl-alt-shift-r"],
      "alt-2": ["workspace::SendKeystrokes", "ctrl-alt-shift-a ctrl-alt-shift-b"],
      "alt-3": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-3 ctrl-alt-shift-r"],
      "alt-4": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-4 ctrl-alt-shift-r"],
      "alt-5": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-5 ctrl-alt-shift-r"],
      "alt-6": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-6 ctrl-alt-shift-r"],
      "alt-7": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-7 ctrl-alt-shift-r"],
      "alt-8": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-8 ctrl-alt-shift-r"],
      "alt-9": ["workspace::SendKeystrokes", "ctrl-alt-shift-t ctrl-alt-shift-9 ctrl-alt-shift-r"],
      "alt-n": ["action::Sequence", ["workspace::NewTerminal", "terminal_panel::ToggleFocus"]],
      "space": "project_panel::OpenPermanent",
      "space enter": "project_panel::OpenPermanent",
      "space e": "project_panel::Toggle",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "space e": "project_panel::Toggle",
    },
  },
]
