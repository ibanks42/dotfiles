{
  "$schema": "vscode://schemas/color-theme",
  "name": "Modest Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1C1F25",
    "editor.foreground": "#abb2bf",
    "editorLineNumber.foreground": "#495162",
    "editorLineNumber.activeForeground": "#abb2bf",
    "editorCursor.foreground": "#5ab0f6",
    "editor.selectionBackground": "#2C3444",
    "editor.inactiveSelectionBackground": "#242C3C",
    "editor.selectionHighlightBackground": "#242C3C",
    "editor.findMatchBackground": "#3e4452",
    "editor.findMatchHighlightBackground": "#2C344480",
    "editor.lineHighlightBackground": "#1C1F25",
    "editor.lineHighlightBorder": "#00000000",
    "editorIndentGuide.background1": "#242C3C",
    "editorIndentGuide.activeBackground1": "#3e4452",
    "editorWhitespace.foreground": "#242C3C",
    "editorRuler.foreground": "#242C3C",
    "editorBracketMatch.background": "#242C3C",
    "editorBracketMatch.border": "#3e4452",
    "editorBracketHighlight.foreground1": "#abb2bf",
    "editorBracketHighlight.foreground2": "#abb2bf",
    "editorBracketHighlight.foreground3": "#abb2bf",
    "editorBracketHighlight.foreground4": "#abb2bf",
    "editorBracketHighlight.foreground5": "#abb2bf",
    "editorBracketHighlight.foreground6": "#abb2bf",
    "editorGutter.background": "#1C1F25",
    "editorWidget.background": "#1C1F25",
    "editorWidget.border": "#242C3C",
    "editorHoverWidget.background": "#1C1F25",
    "editorHoverWidget.border": "#242C3C",
    "editorSuggestWidget.background": "#1C1F25",
    "editorSuggestWidget.border": "#242C3C",
    "editorSuggestWidget.selectedBackground": "#242C3C",
    "editorError.foreground": "#ef5f6b",
    "editorWarning.foreground": "#D6A07A",
    "editorOverviewRuler.border": "#242C3C",
    "editorLink.activeForeground": "#5ab0f6",

    "sideBar.background": "#1C1F25",
    "sideBar.foreground": "#abb2bf",
    "sideBarTitle.foreground": "#abb2bf",
    "sideBarSectionHeader.background": "#1B2230",
    "sideBarSectionHeader.border": "#242C3C",
    "activityBar.background": "#1C1F25",
    "activityBar.foreground": "#abb2bf",
    "activityBar.inactiveForeground": "#495162",
    "activityBarBadge.background": "#242C3C",
    "activityBarBadge.foreground": "#abb2bf",
    "activityBar.border": "#242C3C",

    "titleBar.activeBackground": "#1C1F25",
    "titleBar.activeForeground": "#abb2bf",
    "titleBar.inactiveBackground": "#1C1F25",
    "titleBar.inactiveForeground": "#495162",
    "titleBar.border": "#242C3C",

    "statusBar.background": "#1C1F25",
    "statusBar.foreground": "#abb2bf",
    "statusBar.border": "#242C3C",
    "statusBar.noFolderBackground": "#1C1F25",
    "statusBar.debuggingBackground": "#242C3C",

    "tab.activeBackground": "#242C3C",
    "tab.activeForeground": "#e6e6e6",
    "tab.inactiveBackground": "#1C1F25",
    "tab.inactiveForeground": "#495162",
    "tab.border": "#1C1F25",
    "tab.activeBorderTop": "#5ab0f6",
    "editorGroupHeader.tabsBackground": "#1C1F25",
    "editorGroupHeader.tabsBorder": "#242C3C",

    "panel.background": "#1C1F25",
    "panel.border": "#242C3C",
    "panelTitle.activeForeground": "#abb2bf",
    "panelTitle.inactiveForeground": "#495162",

    "terminal.background": "#1C1F25",
    "terminal.foreground": "#abb2bf",
    "terminal.ansiBlack": "#3f4451",
    "terminal.ansiBrightBlack": "#4f5666",
    "terminal.ansiRed": "#ef5f6b",
    "terminal.ansiBrightRed": "#ef5f6b",
    "terminal.ansiGreen": "#8cc265",
    "terminal.ansiBrightGreen": "#a5e075",
    "terminal.ansiYellow": "#ebc275",
    "terminal.ansiBrightYellow": "#ebc275",
    "terminal.ansiBlue": "#5ab0f6",
    "terminal.ansiBrightBlue": "#5ab0f6",
    "terminal.ansiMagenta": "#c162de",
    "terminal.ansiBrightMagenta": "#de73ff",
    "terminal.ansiCyan": "#4dbdcb",
    "terminal.ansiBrightCyan": "#4dbdcb",
    "terminal.ansiWhite": "#d7dae0",
    "terminal.ansiBrightWhite": "#e6e6e6",
    "terminalCursor.foreground": "#5ab0f6",

    "list.activeSelectionBackground": "#242C3C",
    "list.activeSelectionForeground": "#e6e6e6",
    "list.inactiveSelectionBackground": "#1B2230",
    "list.hoverBackground": "#1B2230",
    "list.focusOutline": "#242C3C",
    "list.highlightForeground": "#5ab0f6",

    "input.background": "#1B2230",
    "input.border": "#242C3C",
    "input.foreground": "#abb2bf",
    "input.placeholderForeground": "#495162",
    "dropdown.background": "#1B2230",
    "dropdown.border": "#242C3C",
    "focusBorder": "#242C3C",
    "foreground": "#abb2bf",
    "descriptionForeground": "#495162",
    "errorForeground": "#ef5f6b",
    "widget.shadow": "#00000080",

    "scrollbarSlider.background": "#242C3C45",
    "scrollbarSlider.hoverBackground": "#242C3C",
    "scrollbarSlider.activeBackground": "#3e4452",

    "gitDecoration.addedResourceForeground": "#a5e075",
    "gitDecoration.modifiedResourceForeground": "#e5c07b",
    "gitDecoration.deletedResourceForeground": "#ff616e",
    "gitDecoration.untrackedResourceForeground": "#a5e075",
    "gitDecoration.ignoredResourceForeground": "#636b78",
    "gitDecoration.conflictingResourceForeground": "#de73ff",
    "gitDecoration.stageModifiedResourceForeground": "#e5c07b",

    "notifications.background": "#1B2230",
    "notifications.border": "#242C3C",
    "notificationCenterHeader.background": "#1B2230",
    "badge.background": "#242C3C",
    "badge.foreground": "#abb2bf",
    "button.background": "#242C3C",
    "button.foreground": "#abb2bf",
    "button.hoverBackground": "#2C3444",
    "button.secondaryBackground": "#1C1F25",
    "checkbox.background": "#1B2230",
    "progressBar.background": "#5ab0f6",

    "peekView.border": "#242C3C",
    "peekViewEditor.background": "#1B2230",
    "peekViewResult.background": "#1B2230",
    "minimap.background": "#1C1F25",
    "settings.headerForeground": "#abb2bf",
    "debugToolBar.background": "#1B2230",
    "merge.currentHeaderBackground": "#3b5135",
    "merge.incomingHeaderBackground": "#31445c",
    "diffEditor.insertedTextBackground": "#3b513580",
    "diffEditor.removedTextBackground": "#572a3280"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#d7dae0",
    "variable.readonly": "#d7dae0",
    "parameter": "#d7dae0",
    "enumMember": "#d7dae0",
    "property": "#e5c07b",
    "property.readonly": "#e5c07b",
    "function": { "foreground": "#5ab0f6", "italic": false },
    "method": { "foreground": "#5ab0f6", "italic": false },
    "type": "#4EC9B0",
    "class": "#4EC9B0",
    "interface": "#4EC9B0",
    "struct": "#4EC9B0",
    "enum": "#4EC9B0",
    "typeParameter": "#4EC9B0",
    "string": "#A3BE8C",
    "number": "#B4A7D6",
    "boolean": "#B4A7D6",
    "operator": "#abb2bf"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#546178", "fontStyle": "" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#ebc275" } },
    { "scope": ["constant", "support.constant"], "settings": { "foreground": "#d7dae0" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#B4A7D6" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#A3BE8C" } },
    { "scope": ["entity.name.function", "support.function", "variable.function", "meta.function-call.generic.python"], "settings": { "foreground": "#5ab0f6", "fontStyle": "" } },
    { "scope": ["keyword", "storage.modifier"], "settings": { "foreground": "#c678dd", "fontStyle": "" } },
    { "scope": ["storage.type", "keyword.declaration"], "settings": { "foreground": "#e06c75", "fontStyle": "" } },
    { "scope": ["entity.name.tag", "variable.other.tag"], "settings": { "foreground": "#e06c75" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "storage.type.string.go", "storage.type.numeric.go", "new.expr.ts entity.name.function", "new.expr.tsx entity.name.function"], "settings": { "foreground": "#4EC9B0" } },
    { "scope": ["support.type.property-name.json", "punctuation.support.type.property-name.begin.json", "punctuation.support.type.property-name.end.json"], "settings": { "foreground": "#e5c07b", "fontStyle": "" } },
    { "scope": ["constant.language.json", "constant.language.boolean", "constant.language.bool.rust", "constant.language.python"], "settings": { "foreground": "#B4A7D6", "fontStyle": "" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "variable.other.constant.property", "variable.other.constant.object.property", "support.variable.property", "variable.object.property", "meta.object-literal.key", "meta.object-literal.key string.quoted", "meta.object-literal.key punctuation.definition.string", "entity.name.tag.yaml", "entity.name.tag.yaml punctuation.definition.string", "support.type.property-name.css", "meta.attribute.python"], "settings": { "foreground": "#e5c07b" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string", "markup.inline.raw", "markup.fenced_code.block"], "settings": { "foreground": "#A3BE8C" } },
    { "scope": ["string.regexp"], "settings": { "foreground": "#A3BE8C" } },
    { "scope": ["string.other.link"], "settings": { "foreground": "#56b6c2" } },
    { "scope": ["variable", "variable.other", "variable.other.readwrite", "variable.parameter"], "settings": { "foreground": "#d7dae0" } },
    { "scope": ["variable.other.constant", "variable.language.this", "variable.language.super"], "settings": { "foreground": "#d7dae0" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#abb2bf", "fontStyle": "" } },
    { "scope": ["keyword.operator.new", "keyword.operator.expression"], "settings": { "foreground": "#c678dd", "fontStyle": "" } },
    { "scope": ["meta.brace", "meta.embedded"], "settings": { "foreground": "#abb2bf", "fontStyle": "" } },
    { "scope": ["punctuation.definition.tag"], "settings": { "foreground": "#e06c75" } },
    { "scope": ["meta.preprocessor"], "settings": { "foreground": "#c678dd", "fontStyle": "" } },
    { "scope": ["invalid"], "settings": { "foreground": "#ff616e" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#ebc275" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#5ab0f6" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#a5e075" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#ff616e" } }
  ]
}
