# Private by default. Review new files before adding an exception.
# This excludes credentials, models, sessions, tasks, caches, npm installs,
# logs, captures, local providers, and future extension state.
*
!/.gitignore
!/README.md
!/agent/

# Portable preferences and agent definitions.
!/agent/settings.json
!/agent/pi-codex-conversion.json
!/agent/subagents.json
!/agent/subtask-router.json
!/agent/zentui.json
!/agent/agents/
!/agent/agents/Explore.md

# Reviewed extension source. Runtime files remain ignored.
!/agent/extensions/
!/agent/extensions/cache-forensics.ts
!/agent/extensions/cache-forensics-tests/
!/agent/extensions/cache-forensics-tests/cache-forensics.test.ts
!/agent/extensions/cache-diagnostics/
!/agent/extensions/cache-diagnostics/index.ts
!/agent/extensions/cache-diagnostics/fingerprint.ts
!/agent/extensions/cache-diagnostics/store.ts
!/agent/extensions/cache-diagnostics/schema.ts
!/agent/extensions/cache-diagnostics/report.ts
!/agent/extensions/cache-diagnostics/README.md
!/agent/extensions/cache-diagnostics/tests/
!/agent/extensions/cache-diagnostics/tests/cache-diagnostics.test.ts
!/agent/extensions/cache-diagnostics/tests/concurrent-writer.ts
!/agent/extensions/cache-diagnostics/tests/fifo-probe.ts
!/agent/extensions/cache-diagnostics/tests/runner.integration.test.ts
!/agent/extensions/herdr-agent-state.ts
!/agent/extensions/subtask-router/
!/agent/extensions/subtask-router/index.ts
!/agent/extensions/subtask-router/policy.ts
!/agent/extensions/subtask-router/rpc.ts
!/agent/extensions/subtask-router/README.md
!/agent/extensions/subtask-router/tests/
!/agent/extensions/subtask-router/tests/router.test.ts
!/agent/extensions/usage-meters/
!/agent/extensions/usage-meters/core.js
!/agent/extensions/usage-meters/index.js
!/agent/extensions/usage-meters/LICENSE
!/agent/extensions/usage-meters/README.md

# Diagnostic tools, never their captures, reports, or state.
!/agent/cache-forensics/
!/agent/cache-forensics/analyze.py
!/agent/cache-forensics/test_analyze.py
!/agent/cache-forensics/README.md

# Manual reviewer source only; snapshots and packets remain private.
!/agent/agents/subtask-reviewer.md
!/agent/extensions/subtask-router/reviewer.ts
!/agent/extensions/subtask-router/tests/reviewer.test.ts

# Unified update patches and offline checks. Backups stay private.
!/agent/patches/
!/agent/patches/diffs/
!/agent/patches/checks/
!/agent/patches/checks/fixtures/
!/agent/patches/README.md
!/agent/patches/manifest.json
!/agent/patches/pi
!/agent/patches/runner.py
!/agent/patches/test_runner.py
!/agent/patches/test_launcher.py
!/agent/patches/diffs/claude-bridge.patch
!/agent/patches/diffs/ask-user-question-host-peers.patch
!/agent/patches/diffs/opencode-direct-host-peers.patch
!/agent/patches/diffs/subagents-host-peers.patch
!/agent/patches/diffs/multi-account-host-peers.patch
!/agent/patches/diffs/multi-account-oauth-init.patch
!/agent/patches/checks/host-peers.test.mjs
!/agent/patches/checks/multi-account-oauth.test.mjs
!/agent/patches/checks/target.mjs
!/agent/patches/checks/root-union.test.mjs
!/agent/patches/checks/cache-trace.test.mjs
!/agent/patches/checks/catalog.test.mjs
!/agent/patches/checks/sdk.test.mjs
!/agent/patches/checks/web-access.test.mjs
!/agent/patches/checks/fixtures/index.ts
!/agent/patches/checks/fixtures/transcript.ts
!/agent/patches/checks/fixtures/notebook-schema.json
