# Private by default. Review new files before adding an exception.
# This excludes credentials, models, sessions, tasks, caches, npm installs,
# logs, captures, local providers, and future extension state.
*
!/.gitignore
!/README.md
!/agent/

# Portable preferences and agent definitions.
!/agent/settings.json
!/agent/pi-codex-conversion.json
!/agent/subagents.json
!/agent/subtask-router.json
!/agent/zentui.json
!/agent/agents/
