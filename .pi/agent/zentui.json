{
  "components": {
    "editor": {
      "enabled": true,
      "style": "opencode-copy-friendly",
      "codexQuota": true,
      "colorSource": "terminal",
      "borderColorMode": "adaptive",
      "modelLabel": "id",
      "viewportIndicators": true,
      "styles": {
        "opencode": {
          "metadataFormat": "$model  $provider(  $thinking)(  $codex_quota)",
          "completionMenu": "palette"
        },
        "opencode-copy-friendly": {
          "metadataFormat": "$model  $provider(  $thinking)(  $codex_quota)",
          "completionMenu": "palette"
        },
        "accent-rail": {
          "rail": "▎",
          "asciiRail": "|",
          "transparent": false
        },
        "minimalist": {
          "pathDisplay": "project",
          "contextFormat": "percent-total",
          "contextGauge": false,
          "showSessionName": true,
          "showTimer": true,
          "showCost": false,
          "showCacheHit": true,
          "showGit": false,
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "separator": "dash"
        }
      }
    },
    "footer": {
      "style": "starship",
      "codexQuota": false,
      "colorSource": "terminal",
      "modelLabel": "id",
      "styles": {
        "starship": {
          "format": "",
          "responsive": true,
          "compactFormat": "$cwd$wrap(in $session_name)$wrap(on $git_branch) $git_status$wrap$context$wrap_sep$tokens$wrap_sep($codex_quota)",
          "compactMaxLines": 1,
          "separator": "pipe",
          "contextStyle": "text",
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "pathDisplay": {
            "mode": "basename",
            "depth": 0
          },
          "segments": {
            "cwd": true,
            "sessionName": true,
            "gitBranch": true,
            "gitStatus": false,
            "gitCounts": true,
            "gitCommit": false,
            "gitMetrics": true,
            "runtime": false,
            "modelInfo": false,
            "context": false,
            "tokens": false,
            "cost": false,
            "sessionDuration": true,
            "username": false,
            "time": true,
            "os": false,
            "packageVersion": false
          },
          "gitBranch": {
            "maxLength": "full"
          },
          "gitCommit": {
            "hashLength": 7,
            "onlyDetached": true,
            "showTag": true
          },
          "gitMetrics": {
            "onlyNonzero": true,
            "ignoreSubmodules": false
          },
          "extensionStatuses": {
            "defaultPlacement": "middle",
            "placements": {
              "codex-cache": "off",
              "multi-account-quota": "off",
              "pi-lens-lsp": "off"
            },
            "colorModes": {
              "codex-cache": "zentui",
              "multi-account-quota": "original",
              "pi-lens-lsp": "zentui"
            }
          }
        }
      }
    },
    "userMessages": {
      "enabled": true,
      "style": "framed-copy-friendly",
      "colorSource": "terminal",
      "styles": {
        "framed": {},
        "framed-copy-friendly": {},
        "compact": {},
        "labeled": {}
      }
    },
    "selectorBorders": {
      "enabled": true,
      "style": "zentui",
      "colorSource": "terminal"
    },
    "thinkingSteps": {
      "enabled": true,
      "mode": "tree"
    },
    "workingLine": {
      "enabled": true,
      "turnSummary": true,
      "spinner": "pinwheel",
      "spinnerIntervalMs": 160,
      "animateSpinnerColor": false,
      "textIntervalMs": 60,
      "textAnimation": "disabled",
      "colorSource": "terminal",
      "messages": {
        "custom": false,
        "values": [
          "Sautéing…",
          "Cooking…",
          "Ionizing…",
          "Zigzagging…",
          "Razzle-dazzling…",
          "Photosynthesizing…",
          "Nucleating…",
          "Brewing…",
          "Combobulating…",
          "Boogieing…",
          "Befuddling…",
          "Alchemizing…",
          "Conjuring…",
          "Baking…",
          "Simmering…",
          "Blanching…"
        ]
      },
      "segments": {
        "tool": false,
        "elapsed": true,
        "thought": true,
        "tokens": true
      }
    }
  },
  "icons": {
    "mode": "auto"
  }
}
