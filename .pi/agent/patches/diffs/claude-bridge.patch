@@ -0,0 +1,36 @@
+// Local fork stopgap: pi-ai 0.87.1 does not yet list Sonnet 5.5.
+// Remove this module and its index.ts call once the host pi-ai catalog ships
+// claude-sonnet-5-5. An authoritative catalog entry always wins, unchanged.
+// Only provider-registration fields are copied: Sonnet 5's 1M window,
+// 128K output limit, text/image input and effort map are provisional metadata
+// for 5.5, not independent measurements of those catalog fields. The bridge's
+// separate [1m] runtime policy is measured (diag/CONTEXT-SIZE.md). Do not
+// copy Sonnet 5's prices, API settings, cache limits or other capabilities.
+
+type CatalogFallback = {
+	id: string;
+	name: string;
+	reasoning: boolean;
+	input: string[];
+	contextWindow: number;
+	maxTokens: number;
+	thinkingLevelMap?: Record<string, string | null>;
+};
+
+export function withCatalogFallbacks<T extends CatalogFallback>(models: readonly T[]): Array<T | CatalogFallback> {
+	const result: Array<T | CatalogFallback> = [...models];
+	if (models.some((model) => model.id === "claude-sonnet-5-5")) return result;
+	const sonnet5 = models.find((model) => model.id === "claude-sonnet-5");
+	if (!sonnet5) return result;
+
+	result.push({
+		id: "claude-sonnet-5-5",
+		name: "Claude Sonnet 5.5",
+		reasoning: sonnet5.reasoning,
+		input: [...sonnet5.input],
+		contextWindow: sonnet5.contextWindow,
+		maxTokens: sonnet5.maxTokens,
+		...(sonnet5.thinkingLevelMap ? { thinkingLevelMap: { ...sonnet5.thinkingLevelMap } } : {}),
+	});
+	return result;
+}
