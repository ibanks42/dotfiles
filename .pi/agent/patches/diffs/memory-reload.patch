 export default function (pi: ExtensionAPI) {
+	pi.registerCommand("reload-extensions", {
+		description: "Reload resources while preserving the current memory snapshot (ordinary /reload refreshes memory)",
+		handler: async (_args, ctx) => {
+			await ctx.waitForIdle();
+			const saved: ReloadSnapshot = {
+				sessionId: ctx.sessionManager.getSessionId(), memoryDir: MEMORY_DIR,
+				text: memorySnapshot, takenAt: snapshotTakenAt, takenOnDate: snapshotTakenOnDate,
+				reason: snapshotReason, dirty: snapshotDirty,
+			};
+			reloadSnapshots.set(saved.sessionId, saved);
+			try { await ctx.reload(); }
+			catch (error) {
+				if (reloadSnapshots.get(saved.sessionId) === saved) reloadSnapshots.delete(saved.sessionId);
+				throw error;
+			}
+			// The old ctx/runtime is invalid now. Do not use it after reload.
+		},
+	});
