 let snapshotReason: string | null = null;
 let snapshotDirty = false;
 
+// Process-local, one-shot handoff across extension runtime replacement. Never
+// persist raw memory in the session log or a new file just to support reload.
+const reloadSnapshotKey = Symbol.for("pi-memory.reload-extensions.snapshot.v1");
+type ReloadSnapshot = {
+	sessionId: string; memoryDir: string;
+	text: string | null; takenAt: string | null; takenOnDate: string | null;
+	reason: string | null; dirty: boolean;
+};
+const reloadState = globalThis as typeof globalThis & { [reloadSnapshotKey]?: Map<string, ReloadSnapshot> };
+const reloadSnapshots = reloadState[reloadSnapshotKey] ??= new Map<string, ReloadSnapshot>();
+
+function takeReloadSnapshot(reason: string | undefined, sessionId: string): boolean {
+	const saved = reloadSnapshots.get(sessionId);
+	if (!saved) return false;
+	reloadSnapshots.delete(sessionId);
+	if (reason !== "reload" || saved.memoryDir !== MEMORY_DIR) return false;
+	memorySnapshot = saved.text;
+	snapshotTakenAt = saved.takenAt;
+	snapshotTakenOnDate = saved.takenOnDate;
+	snapshotReason = saved.reason;
+	snapshotDirty = saved.dirty;
+	return true;
+}
+
 function refreshMemorySnapshot(reason: string) {
 	memorySnapshot = buildMemoryContext("");
 	snapshotTakenAt = nowTimestamp();
