+let piAiOauthWarmup: Promise<PiAiOauthBridge | undefined> | undefined;
+let piAiOauthAsyncError: string | undefined;
+
+/**
+ * Async fallback for {@link tryLoadPiAiOauth}. NEVER throws.
+ *
+ * A failed native import elsewhere in the host (for example jiti first trying an
+ * extension's `.js` entry natively) can leave pi-ai's provider modules half-loaded in
+ * Node's ESM map. require() of them then throws ERR_REQUIRE_ESM_RACE_CONDITION for
+ * the rest of the process, while import() of the same files still completes. The
+ * factory awaits this once so the synchronous getters below see a cached bridge.
+ */
+export function warmPiAiOauth(): Promise<PiAiOauthBridge | undefined> {
+	const ready = tryLoadPiAiOauth();
+	if (ready) return Promise.resolve(ready);
+	const root = findPiAiRoot();
+	if (!root) return Promise.resolve(undefined);
+	piAiOauthWarmup ??= (async () => {
+		const tried: string[] = [];
+		const load = async (relative: string): Promise<any> => {
+			const file = join(root, "dist", relative);
+			if (!existsSync(file)) return undefined;
+			try {
+				return await import(/* @vite-ignore */ file);
+			} catch (error) {
+				tried.push(
+					`${relative}: ${error instanceof Error ? error.message : String(error)}`,
+				);
+				return undefined;
+			}
+		};
+		// Sequential, in the same order as the synchronous path.
+		const bridge =
+			adaptLegacyOauthEntry(await load("oauth.js")) ??
+			adaptProviderFactories(
+				await load(join("providers", "anthropic.js")),
+				await load(join("providers", "openai-codex.js")),
+				await load(join("providers", "kimi-coding.js")),
+				await load(join("providers", "xai.js")),
+			);
+		if (bridge) {
+			piAiOauthBridge = bridge;
+			piAiOauthLoadError = undefined;
+			piAiOauthAsyncError = undefined;
+			return bridge;
+		}
+		tried.push("dist/providers/{anthropic,openai-codex}.js exposed no auth.oauth");
+		piAiOauthAsyncError = tried.join("; ");
+		return undefined;
+	})().finally(() => {
+		piAiOauthWarmup = undefined;
+	});
+	return piAiOauthWarmup;
+}
