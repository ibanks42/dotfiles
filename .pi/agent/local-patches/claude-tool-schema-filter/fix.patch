+/** Claude Code accepts only object-rooted MCP input schemas and rejects root combinators. */
+export type ToolSchemaExclusionReason =
+  | "root_anyOf"
+  | "root_allOf"
+  | "root_oneOf"
+  | "root_type";
+
+export interface ToolSchemaExclusion {
+  name: string;
+  reason: ToolSchemaExclusionReason;
+}
+
+/**
+ * Keep this check deliberately shallow. Claude Code rejects root combinators,
+ * while unions nested under object properties are valid JSON Schema and remain
+ * available to Claude.
+ */
+export function claudeToolSchemaExclusion(
+  name: string,
+  schema: Record<string, unknown>,
+): ToolSchemaExclusion | undefined {
+  if (schema.anyOf !== undefined) return { name, reason: "root_anyOf" };
+  if (schema.allOf !== undefined) return { name, reason: "root_allOf" };
+  if (schema.oneOf !== undefined) return { name, reason: "root_oneOf" };
+  if (schema.type !== "object") return { name, reason: "root_type" };
+  return undefined;
+}
+
+const REASON_TEXT: Record<ToolSchemaExclusionReason, string> = {
+  root_anyOf: "top-level anyOf is unsupported",
+  root_allOf: "top-level allOf is unsupported",
+  root_oneOf: "top-level oneOf is unsupported",
+  root_type: 'root type is not "object"',
+};
+
+const MAX_WARNING_TOOLS = 12;
+
+/** User-visible text contains only bounded tool names and fixed reason labels. */
+export function formatToolSchemaExclusionWarning(
+  exclusions: readonly ToolSchemaExclusion[],
+): string {
+  const sorted = [...exclusions]
+    .sort((left, right) => compareText(left.name, right.name) || compareText(left.reason, right.reason));
+  const shown = sorted.slice(0, MAX_WARNING_TOOLS);
+  const details = shown
+    .map((exclusion) => `${JSON.stringify(sanitizeToolName(exclusion.name))} (${REASON_TEXT[exclusion.reason]})`)
+    .join(", ");
+  const omitted = sorted.length - shown.length;
+  const omittedText = omitted > 0 ? `, plus ${omitted} more` : "";
+  return `[pi-claude-code-provider] Claude excluded incompatible Pi tool${exclusions.length === 1 ? "" : "s"}: ${details}${omittedText}. The tool${exclusions.length === 1 ? " is" : "s are"} still active in Pi but unavailable to this Claude request.`;
+}
+
+function sanitizeToolName(name: string): string {
+  const printable = name
+    .replace(/[\u0000-\u001f\u007f-\u009f\u202a-\u202e\u2066-\u2069]/g, "�")
+    .replace(/\s+/g, " ")
+    .trim();
+  const points = [...printable];
+  return points.length <= 80 ? printable : `${points.slice(0, 79).join("")}…`;
+}
+
+function compareText(left: string, right: string): number {
+  return left < right ? -1 : left > right ? 1 : 0;
+}
+
+/** Deduplicate repeated catalogs for one session without retaining schema data. */
+export function createToolSchemaExclusionNotifier(
+  notify: (message: string) => void,
+  maxTracked = 64,
+): (exclusions: readonly ToolSchemaExclusion[]) => void {
+  const emitted = new Set<string>();
+  return (exclusions) => {
+    if (exclusions.length === 0) return;
+    const message = formatToolSchemaExclusionWarning(exclusions);
+    if (emitted.has(message)) return;
+    if (emitted.size >= maxTracked) {
+      const [oldest] = emitted;
+      if (oldest !== undefined) emitted.delete(oldest);
+    }
+    emitted.add(message);
+    notify(message);
+  };
+}
+
+/** Pi's SDK UI is a documented no-op; stderr is its supported visible fallback. */
+export function reportToolSchemaExclusionWarning(
+  hasUI: boolean,
+  notify: (message: string) => void,
+  warn: (message: string) => void,
+  message: string,
+): void {
+  if (hasUI) notify(message);
+  else warn(message);
+}
