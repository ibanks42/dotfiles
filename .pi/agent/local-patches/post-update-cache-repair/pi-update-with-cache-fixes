#!/usr/bin/env bash
set -euo pipefail

repair="${HOME}/.pi/agent/local-patches/post-update-cache-repair/repair.py"
pi_bin="${PI_REAL_BIN:-$(command -v pi)}"

if [[ ! -x "${pi_bin}" ]]; then
  printf 'pi update wrapper: Pi executable not found: %s\n' "${pi_bin}" >&2
  exit 1
fi
if [[ ! -f "${repair}" ]]; then
  printf 'pi update wrapper: repair script not found: %s\n' "${repair}" >&2
  exit 1
fi

"${pi_bin}" update "$@"
python3 "${repair}" apply
printf '%s\n' 'Pi update completed and reviewed cache fixes are present. Restart Pi processes that were already running.'
