{
  "lastChangelogVersion": "1.4.0",
  "terminal": {
    "showTerminalProgress": true
  },
  "steeringMode": "all",
  "followUpMode": "all",
  "showCacheMissNotices": true,
  "tuiMode": "regular",
  "theme": "system/system",
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-luna",
    "claude-bridge/claude-fable-5-1",
    "claude-bridge/claude-opus-5-5",
    "claude-bridge/claude-sonnet-5-5",
    "xai/grok-4.6",
    "xai/grok-4.7",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/gemini-4-argon"
  ],
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@narumitw/pi-goal",
    "npm:pi-opencode-direct",
    {
      "source": "npm:@tintinweb/pi-subagents",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    "npm:pi-claude-bridge",
    "npm:openwiki",
    "npm:pi-cc-extensions",
    "npm:@xzzpig/pi-starline@0.5.1",
    "npm:pi-intercom",
    "npm:@maxiaochao/pi-toolkit",
    "npm:pi-session-name",
    "npm:pi-memory"
  ],
  "fullscreenScrollbar": "always",
  "doubleEscapeAction": "tree",
  "enableInstallTelemetry": false,
  "quietStartup": true,
  "collapseChangelog": true,
  "showHardwareCursor": true,
  "hideThinkingBlock": false,
  "editorPaddingX": 0,
  "fullscreenExitOutput": "resume-hint",
  "cacheWarming": "idle",
  "npmCommand": [
    "bun-as-npm"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "codemode": {
    "mode": "on",
    "inlineBudget": 10000
  },
  "outputPad": 0,
  "extensions": [
    "-extensions/subtask-router/index.ts",
    "-extensions/cache-diagnostics/index.ts",
    "-extensions/cache-forensics.ts"
  ],
  "markdown": {
    "mermaid": "streaming"
  },
  "treeFilterMode": "user-only",
  "autocompleteMaxVisible": 7
}