{
  "lastChangelogVersion": "0.99.2",
  "terminal": {
    "showTerminalProgress": true
  },
  "steeringMode": "all",
  "followUpMode": "all",
  "showCacheMissNotices": true,
  "tuiMode": "fullscreen",
  "theme": "dark",
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-6-luna",
    "opencode-zen-free/muse-spark-1.3-contributor-free",
    "zai/glm-5.3",
    "zai/glm-5.3-flash",
    "zai/glm-5.3-highspeed",
    "claude-bridge/claude-fable-5-1",
    "claude-bridge/claude-opus-5-5",
    "claude-bridge/claude-sonnet-5-5"
  ],
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-multi-account",
    "npm:@narumitw/pi-goal",
    "npm:pi-opencode-direct",
    "npm:@tintinweb/pi-subagents",
    "npm:pi-claude-bridge",
    "npm:openwiki",
    "npm:pi-cc-extensions",
    "npm:@xzzpig/pi-starline"
  ],
  "fullscreenScrollbar": "always",
  "doubleEscapeAction": "tree",
  "enableInstallTelemetry": false,
  "quietStartup": true,
  "collapseChangelog": true,
  "showHardwareCursor": true,
  "hideThinkingBlock": false,
  "editorPaddingX": 0,
  "fullscreenExitOutput": "resume-hint",
  "cacheWarming": "idle",
  "npmCommand": [
    "bun-as-npm"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "codemode": {
    "mode": "on",
    "inlineBudget": 10000
  }
}